{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vozual.app/schemas/motion-semantics-v2.schema.json",
  "title": "Vozual universal LSC-CO motion semantics v2",
  "description": "Additive, rig-independent semantic sidecar. It never replaces legacy landmark frames or authored kinematic recipes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "gloss", "language", "regionalVariant", "durationMs", "manualTracks", "trajectories", "anatomicalRelations", "bilateralCoordination", "handshapeEvents", "nonManualEvents", "validation"],
  "properties": {
    "schema": {"const": "vozual.motion-semantics"},
    "schemaVersion": {"const": 2},
    "gloss": {"type": "string", "minLength": 1},
    "language": {"const": "lsc"},
    "regionalVariant": {"const": "lsc-CO"},
    "durationMs": {"type": "integer", "minimum": 1},
    "manualTracks": {"$ref": "#/$defs/manualTracks"},
    "trajectories": {"type": "array", "items": {"$ref": "#/$defs/trajectory"}},
    "anatomicalRelations": {"type": "array", "items": {"$ref": "#/$defs/anatomicalRelation"}},
    "bilateralCoordination": {"type": "array", "items": {"$ref": "#/$defs/bilateralCoordination"}},
    "handshapeEvents": {"type": "array", "items": {"$ref": "#/$defs/handshapeEvent"}},
    "nonManualEvents": {"type": "array", "items": {"$ref": "#/$defs/nonManualEvent"}},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "side": {"enum": ["left", "right"]},
    "strength": {"enum": ["required", "preferred"]},
    "span": {"type": "object", "additionalProperties": false, "required": ["fromMs", "toMs"], "properties": {"fromMs": {"type": "integer", "minimum": 0}, "toMs": {"type": "integer", "minimum": 0}}},
    "vec3": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false, "minItems": 3, "maxItems": 3},
    "endpoint": {"type": "string", "pattern": "^(hand\\.(left|right)\\.(wrist|palm\\.(center|thenar|hypothenar|radial|ulnar)|(thumb|index|middle|ring|pinky)\\.(mcp|pip|dip|tip))|body\\.(chin|mouth|forehead|chest|shoulder\\.(left|right)))$"},
    "jointMetric": {"type": "string", "pattern": "^hand\\.(left|right)\\.(thumb\\.(cmc|mcp|ip)|(index|middle|ring|pinky)\\.(mcp|pip|dip))\\.(flexionDeg|abductionDeg|twistDeg)$"},
    "manualTrack": {"type": "object", "additionalProperties": false, "required": ["participation", "role"], "properties": {"participation": {"enum": ["active", "support", "inactive", "alternating"]}, "role": {"enum": ["dominant", "non_dominant", "symmetric", "independent", "none"]}}},
    "manualTracks": {"type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": {"left": {"$ref": "#/$defs/manualTrack"}, "right": {"$ref": "#/$defs/manualTrack"}}},
    "waypoint": {"type": "object", "additionalProperties": false, "required": ["timeMs", "position"], "properties": {"timeMs": {"type": "integer", "minimum": 0}, "position": {"$ref": "#/$defs/vec3"}}},
    "trajectory": {"type": "object", "additionalProperties": false, "required": ["id", "effector", "space", "span", "path", "waypoints", "toleranceM"], "properties": {"id": {"$ref": "#/$defs/id"}, "effector": {"$ref": "#/$defs/endpoint"}, "space": {"enum": ["body-local", "hand-local", "world"]}, "span": {"$ref": "#/$defs/span"}, "path": {"enum": ["stationary", "line", "arc", "circle", "compound"]}, "waypoints": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/waypoint"}}, "toleranceM": {"type": "number", "exclusiveMinimum": 0}, "maxSpeedMps": {"type": "number", "exclusiveMinimum": 0}, "maxAccelerationMps2": {"type": "number", "exclusiveMinimum": 0}}},
    "relationBase": {"type": "object", "required": ["id", "type", "span", "strength"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["contact", "proximity", "relative_pose", "joint_coupling"]}, "span": {"$ref": "#/$defs/span"}, "strength": {"$ref": "#/$defs/strength"}}},
    "anatomicalRelation": {"oneOf": [
      {"allOf": [{"$ref": "#/$defs/relationBase"}, {"type": "object", "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "contact"}, "span": {"$ref": "#/$defs/span"}, "strength": {"$ref": "#/$defs/strength"}, "a": {"$ref": "#/$defs/endpoint"}, "b": {"$ref": "#/$defs/endpoint"}, "maxSeparationM": {"type": "number", "minimum": 0}}, "required": ["a", "b", "maxSeparationM"]}]},
      {"allOf": [{"$ref": "#/$defs/relationBase"}, {"type": "object", "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "proximity"}, "span": {"$ref": "#/$defs/span"}, "strength": {"$ref": "#/$defs/strength"}, "a": {"$ref": "#/$defs/endpoint"}, "b": {"$ref": "#/$defs/endpoint"}, "minDistanceM": {"type": "number", "minimum": 0}, "maxDistanceM": {"type": "number", "minimum": 0}}, "required": ["a", "b", "minDistanceM", "maxDistanceM"]}]},
      {"allOf": [{"$ref": "#/$defs/relationBase"}, {"type": "object", "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "relative_pose"}, "span": {"$ref": "#/$defs/span"}, "strength": {"$ref": "#/$defs/strength"}, "a": {"$ref": "#/$defs/endpoint"}, "b": {"$ref": "#/$defs/endpoint"}, "positionM": {"$ref": "#/$defs/vec3"}, "positionToleranceM": {"type": "number", "minimum": 0}}, "required": ["a", "b", "positionM", "positionToleranceM"]}]},
      {"allOf": [{"$ref": "#/$defs/relationBase"}, {"type": "object", "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "joint_coupling"}, "span": {"$ref": "#/$defs/span"}, "strength": {"$ref": "#/$defs/strength"}, "lhs": {"$ref": "#/$defs/jointMetric"}, "rhs": {"$ref": "#/$defs/jointMetric"}, "relation": {"enum": ["equal", "opposed", "within", "ratio"]}, "toleranceDeg": {"type": "number", "minimum": 0}}, "required": ["lhs", "rhs", "relation", "toleranceDeg"]}]}
    ]},
    "bilateralCoordination": {"type": "object", "additionalProperties": false, "required": ["id", "span", "mode", "leftEffector", "rightEffector", "phaseOffsetMs"], "properties": {"id": {"$ref": "#/$defs/id"}, "span": {"$ref": "#/$defs/span"}, "mode": {"enum": ["synchronous", "mirrored", "alternating", "independent"]}, "leftEffector": {"type": "string", "pattern": "^hand\\.left\\."}, "rightEffector": {"type": "string", "pattern": "^hand\\.right\\."}, "phaseOffsetMs": {"type": "integer", "minimum": 0}}},
    "handshapeEvent": {"type": "object", "additionalProperties": false, "required": ["id", "hand", "span", "from", "to", "articulation"], "properties": {"id": {"$ref": "#/$defs/id"}, "hand": {"$ref": "#/$defs/side"}, "span": {"$ref": "#/$defs/span"}, "from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "articulation": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["joint", "fromDeg", "toDeg"], "properties": {"joint": {"$ref": "#/$defs/jointMetric"}, "fromDeg": {"type": "number"}, "toDeg": {"type": "number"}}}}}},
    "nonManualEvent": {"type": "object", "additionalProperties": false, "required": ["id", "channels", "span", "curve", "target"], "properties": {"id": {"$ref": "#/$defs/id"}, "channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["head.pitchDeg", "head.yawDeg", "torso.pitchDeg", "gaze.direction", "eyelids.leftClosure", "eyelids.rightClosure", "brows.leftInnerLift", "brows.rightInnerLift", "brows.leftInnerLower", "brows.rightInnerLower", "mouth.opening", "mouth.pucker", "mouth.width"]}}, "span": {"$ref": "#/$defs/span"}, "curve": {"enum": ["hold", "linear", "smoothstep"]}, "target": {"type": "number", "minimum": -1, "maximum": 1}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["status", "source"], "properties": {"status": {"enum": ["authored", "derived", "reviewed", "needs_review"]}, "source": {"enum": ["motion-schema-v3", "motion-schema-v2", "legacy-landmarks", "unknown"]}, "warnings": {"type": "array", "items": {"type": "string"}}}}
  }
}
