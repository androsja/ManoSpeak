  "domainDecisions": [
    {
      "domain": "size",
      "decision": "documented-construction-specific",
      "summary": "Spatial extent can describe or intensify size for the source-described signs; no universal amplitude scale is defined."
    },
    {
      "domain": "manner",
      "decision": "documented-construction-specific",
      "summary": "Relative articulation speed has the source-described readings for VENIR and SEÑAR/SEÑA; no cross-sign speed threshold is defined."
    },
    {
      "domain": "frequency",
      "decision": "not-an-independent-numeric-domain",
      "summary": "Documented repetition effects are classified under aspect or number; no standalone rate or event-count operator is defined."
    },
    {
      "domain": "aspect",
      "decision": "documented-patterns-with-lexical-context",
      "summary": "Durative, habitual, iterative, and terminative readings are described; the base sign and context constrain the pattern."
    },
    {
      "domain": "number",
      "decision": "documented-construction-specific",
      "summary": "Finger incorporation and spatial repetition are documented for listed signs only; arc count need not equal participant count."
    }
  ],
