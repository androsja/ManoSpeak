{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vozual.app/schemas/motion-schema-v3.schema.json",
  "title": "Vozual authored kinematic motion schema v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "kind", "id", "revision", "rig", "units", "linguisticIntent", "kinematicRealization", "provenance", "linguisticReview"],
  "properties": {
    "schema": {"const": "vozual.motion-schema"},
    "schemaVersion": {"const": 3},
    "kind": {"const": "authored-kinematic-motion"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "rig": {"$ref": "#/$defs/rig"},
    "units": {"$ref": "#/$defs/units"},
    "linguisticIntent": {"$ref": "#/$defs/linguisticIntent"},
    "kinematicRealization": {"$ref": "#/$defs/kinematicRealization"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "linguisticReview": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "finiteNumber": {"type": "number"},
    "nonNegativeNumber": {"type": "number", "minimum": 0},
    "timeMs": {"type": "integer", "minimum": 0},
    "strength": {"enum": ["required", "preferred"]},
    "vec3": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false, "minItems": 3, "maxItems": 3},
    "quat": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false, "minItems": 4, "maxItems": 4},
    "endpoint": {"type": "string", "pattern": "^(?:hand\\.(?:left|right)\\.(?:(?:thumb|index|middle|ring|pinky)\\.(?:mcp|pip|dip|tip)|palm\\.(?:center|thenar|hypothenar|radial|ulnar))|body\\.(?:chin|mouth|forehead|chest|shoulder\\.(?:left|right)))$"},
    "jointMetric": {"type": "string", "pattern": "^hand\\.(?:left|right)\\.(?:thumb\\.(?:cmc|mcp|ip)|(?:index|middle|ring|pinky)\\.(?:mcp|pip|dip))\\.(?:flexionDeg|abductionDeg|twistDeg)$"},
    "rig": {
      "type": "object", "additionalProperties": false,
      "required": ["profileId", "profileRevision", "sha256", "jointMapRevision", "landmarkMapRevision"],
      "properties": {
        "profileId": {"$ref": "#/$defs/id"}, "profileRevision": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}, "jointMapRevision": {"type": "integer", "minimum": 1},
        "landmarkMapRevision": {"type": "integer", "minimum": 1}
      }
    },
    "units": {
      "type": "object", "additionalProperties": false, "required": ["length", "angle", "time"],
      "properties": {"length": {"const": "m"}, "angle": {"const": "deg"}, "time": {"const": "ms"}}
    },
    "linguisticIntent": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "glossSequence", "regionalVariant", "phases"],
      "properties": {
        "language": {"const": "lsc-CO"},
        "glossSequence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-ZÁÉÍÓÚÜÑ¿?0-9_ -]+$"}},
        "regionalVariant": {"type": "string", "minLength": 1},
        "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}}
      }
    },
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "fromMs", "toMs", "nonManualIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "role": {"enum": ["preparation", "stroke", "hold", "retraction"]},
        "fromMs": {"$ref": "#/$defs/timeMs"}, "toMs": {"$ref": "#/$defs/timeMs"},
        "nonManualIds": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "axisTriplet": {
      "type": "object", "additionalProperties": false,
      "required": ["flexionDeg", "abductionDeg", "twistDeg"],
      "properties": {"flexionDeg": {"type": "number"}, "abductionDeg": {"type": "number"}, "twistDeg": {"type": "number"}}
    },
    "flexionOnly": {
      "type": "object", "additionalProperties": false, "required": ["flexionDeg"],
      "properties": {"flexionDeg": {"type": "number"}}
    },
    "thumbJoints": {
      "type": "object", "additionalProperties": false, "required": ["cmc", "mcp", "ip"],
      "properties": {"cmc": {"$ref": "#/$defs/axisTriplet"}, "mcp": {"$ref": "#/$defs/axisTriplet"}, "ip": {"$ref": "#/$defs/flexionOnly"}}
    },
    "fingerJoints": {
      "type": "object", "additionalProperties": false, "required": ["mcp", "pip", "dip"],
      "properties": {"mcp": {"$ref": "#/$defs/axisTriplet"}, "pip": {"$ref": "#/$defs/flexionOnly"}, "dip": {"$ref": "#/$defs/flexionOnly"}}
    },
    "armPose": {
      "type": "object", "additionalProperties": false, "required": ["elbow"],
      "properties": {
        "elbow": {"type": "object", "additionalProperties": false, "required": ["rotationDeg", "space"], "properties": {"rotationDeg": {"$ref": "#/$defs/vec3"}, "space": {"const": "body-local"}}}
      }
    },
    "hand": {
      "type": "object", "additionalProperties": false, "required": ["wrist", "joints"],
      "properties": {
        "arm": {"$ref": "#/$defs/armPose"},
        "wrist": {"type": "object", "additionalProperties": false, "required": ["positionM", "orientationQuat"], "dependentRequired": {"orientationSpace": ["palmFacingDirection"], "palmFacingDirection": ["orientationSpace"]}, "properties": {"positionM": {"$ref": "#/$defs/vec3"}, "orientationQuat": {"$ref": "#/$defs/quat"}, "orientationSpace": {"const": "body-local"}, "palmFacingDirection": {"$ref": "#/$defs/vec3"}, "relativeToForearmDeg": {"$ref": "#/$defs/vec3"}}},
        "joints": {"type": "object", "additionalProperties": false, "required": ["thumb", "index", "middle", "ring", "pinky"], "properties": {"thumb": {"$ref": "#/$defs/thumbJoints"}, "index": {"$ref": "#/$defs/fingerJoints"}, "middle": {"$ref": "#/$defs/fingerJoints"}, "ring": {"$ref": "#/$defs/fingerJoints"}, "pinky": {"$ref": "#/$defs/fingerJoints"}}}
      }
    },
    "nonManualTrack": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "channel", "fromMs", "toMs", "value"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "channel": {"enum": ["headRotationDeg", "gazeDirection", "browRaise", "smile", "mouthOpening", "mouthPucker"]},
        "fromMs": {"$ref": "#/$defs/timeMs"},
        "toMs": {"$ref": "#/$defs/timeMs"},
        "value": {}
      },
      "allOf": [
        {"if": {"properties": {"channel": {"const": "headRotationDeg"}}},
         "then": {"properties": {"value": {"$ref": "#/$defs/vec3"}}}},
        {"if": {"properties": {"channel": {"const": "gazeDirection"}}},
         "then": {"properties": {"value": {"$ref": "#/$defs/vec3"}}}},
        {"if": {"properties": {"channel": {"const": "browRaise"}}},
         "then": {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}}}},
        {"if": {"properties": {"channel": {"const": "smile"}}},
         "then": {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}}}},
        {"if": {"properties": {"channel": {"const": "mouthOpening"}}},
         "then": {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}}}},
        {"if": {"properties": {"channel": {"const": "mouthPucker"}}},
         "then": {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}}}}
      ]
    },
    "nonManual": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fromMs", "toMs", "headRotationDeg", "gazeDirection", "browRaise", "mouthOpening", "mouthPucker"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "fromMs": {"$ref": "#/$defs/timeMs"}, "toMs": {"$ref": "#/$defs/timeMs"},
        "headRotationDeg": {"$ref": "#/$defs/vec3"}, "gazeDirection": {"$ref": "#/$defs/vec3"},
        "browRaise": {"type": "number", "minimum": -1, "maximum": 1}, "smile": {"type": "number", "minimum": 0, "maximum": 1}, "mouthOpening": {"type": "number", "minimum": 0, "maximum": 1}, "mouthPucker": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "keyframe": {
      "type": "object", "additionalProperties": false, "required": ["id", "timeMs", "hands"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "timeMs": {"$ref": "#/$defs/timeMs"}, "hands": {"type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": {"left": {"$ref": "#/$defs/hand"}, "right": {"$ref": "#/$defs/hand"}}}}
    },
    "interval": {"type": "object", "required": ["id", "fromMs", "toMs", "strength"], "properties": {"id": {"$ref": "#/$defs/id"}, "fromMs": {"$ref": "#/$defs/timeMs"}, "toMs": {"$ref": "#/$defs/timeMs"}, "strength": {"$ref": "#/$defs/strength"}}},
    "contact": {
      "type": "object", "additionalProperties": false, "required": ["id", "fromMs", "toMs", "strength", "a", "b", "maxSeparationM"], "properties": {"id": {"$ref": "#/$defs/id"}, "fromMs": {"$ref": "#/$defs/timeMs"}, "toMs": {"$ref": "#/$defs/timeMs"}, "strength": {"$ref": "#/$defs/strength"}, "a": {"$ref": "#/$defs/endpoint"}, "b": {"$ref": "#/$defs/endpoint"}, "maxSeparationM": {"type": "number", "minimum": 0}, "normalAlignmentMin": {"type": "number", "minimum": -1, "maximum": 1}, "approachSpeedMaxMps": {"type": "number", "exclusiveMinimum": 0}, "releaseByMs": {"$ref": "#/$defs/timeMs"}}},
    "proximity": {
      "type": "object", "additionalProperties": false, "required": ["id", "fromMs", "toMs", "strength", "a", "b", "maxDistanceM"], "properties": {"id": {"$ref": "#/$defs/id"}, "fromMs": {"$ref": "#/$defs/timeMs"}, "toMs": {"$ref": "#/$defs/timeMs"}, "strength": {"$ref": "#/$defs/strength"}, "a": {"$ref": "#/$defs/endpoint"}, "b": {"$ref": "#/$defs/endpoint"}, "minDistanceM": {"type": "number", "minimum": 0}, "maxDistanceM": {"type": "number", "exclusiveMinimum": 0}}},
    "relativePose": {
      "type": "object", "additionalProperties": false, "required": ["id", "fromMs", "toMs", "strength", "source", "target", "frame", "positionToleranceM"], "properties": {"id": {"$ref": "#/$defs/id"}, "fromMs": {"$ref": "#/$defs/timeMs"}, "toMs": {"$ref": "#/$defs/timeMs"}, "strength": {"$ref": "#/$defs/strength"}, "source": {"$ref": "#/$defs/endpoint"}, "target": {"$ref": "#/$defs/endpoint"}, "frame": {"enum": ["target-local", "body-local", "avatar"]}, "positionM": {"$ref": "#/$defs/vec3"}, "positionToleranceM": {"type": "number", "exclusiveMinimum": 0}, "orientationQuat": {"$ref": "#/$defs/quat"}, "orientationToleranceDeg": {"type": "number", "minimum": 0, "maximum": 180}}},
    "jointRelation": {
      "type": "object", "additionalProperties": false, "required": ["id", "fromMs", "toMs", "strength", "lhs", "relation", "rhs"], "properties": {"id": {"$ref": "#/$defs/id"}, "fromMs": {"$ref": "#/$defs/timeMs"}, "toMs": {"$ref": "#/$defs/timeMs"}, "strength": {"$ref": "#/$defs/strength"}, "lhs": {"$ref": "#/$defs/jointMetric"}, "relation": {"enum": ["eq", "lte", "gte", "within"]}, "rhs": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/jointMetric"}]}, "toleranceDeg": {"type": "number", "minimum": 0}}},
    "trajectoryWaypoint": {"type": "object", "additionalProperties": false, "required": ["timeMs", "positionM"], "properties": {"timeMs": {"$ref": "#/$defs/timeMs"}, "positionM": {"$ref": "#/$defs/vec3"}, "orientationQuat": {"$ref": "#/$defs/quat"}}},
    "trajectory": {
      "type": "object", "additionalProperties": false, "required": ["id", "fromMs", "toMs", "strength", "target", "space", "path", "positionToleranceM", "curve", "maxSpeedMps", "maxAccelerationMps2", "maxJerkMps3"], "properties": {"id": {"$ref": "#/$defs/id"}, "fromMs": {"$ref": "#/$defs/timeMs"}, "toMs": {"$ref": "#/$defs/timeMs"}, "strength": {"$ref": "#/$defs/strength"}, "target": {"$ref": "#/$defs/endpoint"}, "space": {"enum": ["avatar", "body-local", "hand-local"]}, "path": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/trajectoryWaypoint"}}, "positionToleranceM": {"type": "number", "exclusiveMinimum": 0}, "orientationToleranceDeg": {"type": "number", "minimum": 0, "maximum": 180}, "curve": {"enum": ["linear", "cubic"]}, "maxSpeedMps": {"type": "number", "exclusiveMinimum": 0}, "maxAccelerationMps2": {"type": "number", "exclusiveMinimum": 0}, "maxJerkMps3": {"type": "number", "exclusiveMinimum": 0}, "maxAngularSpeedDegPerSec": {"type": "number", "exclusiveMinimum": 0}, "maxAngularAccelerationDegPerSec2": {"type": "number", "exclusiveMinimum": 0}}},
    "transition": {
      "type": "object", "additionalProperties": false, "required": ["id", "fromKeyframeId", "toKeyframeId", "curve", "continuous", "maxSpeedMps", "maxAccelerationMps2", "maxJerkMps3"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "fromKeyframeId": {"$ref": "#/$defs/id"}, "toKeyframeId": {"$ref": "#/$defs/id"}, "curve": {"enum": ["linear", "cubic"]}, "continuous": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["position", "orientation", "velocity"]}}, "maxSpeedMps": {"type": "number", "exclusiveMinimum": 0}, "maxAccelerationMps2": {"type": "number", "exclusiveMinimum": 0}, "maxJerkMps3": {"type": "number", "exclusiveMinimum": 0}}},
    "kinematicRealization": {
      "type": "object", "additionalProperties": false,
      "required": ["durationMs", "keyframes", "nonManuals", "contacts", "proximities", "relativePoses", "jointRelations", "trajectories", "transitions"],
      "properties": {"durationMs": {"type": "integer", "minimum": 1}, "keyframes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/keyframe"}}, "nonManuals": {"type": "array", "items": {"$ref": "#/$defs/nonManual"}}, "nonManualTracks": {"type": "array", "items": {"$ref": "#/$defs/nonManualTrack"}}, "contacts": {"type": "array", "items": {"$ref": "#/$defs/contact"}}, "proximities": {"type": "array", "items": {"$ref": "#/$defs/proximity"}}, "relativePoses": {"type": "array", "items": {"$ref": "#/$defs/relativePose"}}, "jointRelations": {"type": "array", "items": {"$ref": "#/$defs/jointRelation"}}, "trajectories": {"type": "array", "items": {"$ref": "#/$defs/trajectory"}}, "transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transition"}}}
    },
    "provenance": {"type": "object", "additionalProperties": false, "required": ["authorId", "createdAt", "updatedAt", "sourceSha256"], "properties": {"authorId": {"type": "string", "minLength": 1}, "createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}, "sourceSha256": {"$ref": "#/$defs/sha256"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["status", "language", "reviewerId", "reviewedAt"], "properties": {"status": {"enum": ["draft", "pending", "approved", "rejected"]}, "language": {"const": "lsc-CO"}, "reviewerId": {"type": ["string", "null"]}, "reviewedAt": {"type": ["string", "null"], "format": "date-time"}}}
  }
}
