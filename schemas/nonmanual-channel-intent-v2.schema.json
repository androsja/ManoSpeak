{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vozual.app/schemas/nonmanual-channel-intent-v2.schema.json",
  "title": "Vozual non-manual channel intent v2",
  "description": "Non-executable abstract-channel composition with explicit per-channel policies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "revision", "durationMs", "channels", "tracks", "execution"],
  "properties": {
    "schema": {"const": "vozual.nonmanual-channel-intent"},
    "schemaVersion": {"const": 2},
    "id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "durationMs": {"type": "integer", "minimum": 1},
    "channels": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/channel"}, "additionalProperties": {"$ref": "#/$defs/channelDescriptor"}},
    "tracks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/track"}},
    "execution": {"const": "authoring-only-not-executable"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "channel": {"enum": [
      "eyelids.leftClosure", "eyelids.rightClosure", "eyelids.squint",
      "brows.leftInnerLift", "brows.leftInnerLower", "brows.rightInnerLift", "brows.rightInnerLower",
      "nose.wrinkle", "cheeks.leftRaise", "cheeks.rightRaise", "cheeks.puff",
      "jaw.open", "jaw.forward", "jaw.left", "jaw.right", "tongue.protrude",
      "lips.opening", "lips.pucker", "lips.width", "mouthCorners.left", "mouthCorners.right", "mouthing.lexeme",
      "gaze.target", "head.pitch", "head.yaw", "head.roll",
      "shoulders.leftElevation", "shoulders.rightElevation", "shoulders.centerElevation",
      "torso.pitch", "torso.yaw", "torso.roll"
    ]},
    "vector3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "channelDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "supportedOperations"],
      "properties": {
        "domain": {"enum": ["scalar", "vector", "target-reference", "categorical-action"]},
        "supportedOperations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["exclusive", "override", "additive", "blend"]}},
        "unit": {"type": "string", "minLength": 1},
        "neutral": {"oneOf": [{"type": "number"}, {"$ref": "#/$defs/vector3"}]},
        "compatibilityGroups": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "track": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "channel", "fromMs", "toMs", "intentRef", "composition"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "channel": {"$ref": "#/$defs/channel"},
        "fromMs": {"type": "integer", "minimum": 0},
        "toMs": {"type": "integer", "minimum": 1},
        "intentRef": {"$ref": "#/$defs/id"},
        "composition": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "exclusive"}}},
          {"type": "object", "additionalProperties": false, "required": ["mode", "priority"], "properties": {"mode": {"const": "override"}, "priority": {"type": "integer", "minimum": 0, "maximum": 100}}},
          {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"const": "additive"}}},
          {"type": "object", "additionalProperties": false, "required": ["mode", "weight", "compatibilityGroupId"], "properties": {"mode": {"const": "blend"}, "weight": {"type": "number", "minimum": 0, "maximum": 1}, "compatibilityGroupId": {"$ref": "#/$defs/id"}}}
        ]}
      }
    }
  }
}
