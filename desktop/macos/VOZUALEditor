#!/bin/zsh

set -eu

readonly VOZUAL_REPO="/Users/jflorezgaleano/Documents/JulianFlorez/Vozual"
readonly VOZUAL_PYTHON="/private/tmp/vozual-capture-venv/bin/python"
readonly VOZUAL_LOG_DIR="$HOME/Library/Logs/VOZUAL"
readonly VOZUAL_CACHE_DIR="$HOME/Library/Caches/VOZUAL"

mkdir -p "$VOZUAL_LOG_DIR" "$VOZUAL_CACHE_DIR/matplotlib"
export MPLCONFIGDIR="$VOZUAL_CACHE_DIR/matplotlib"

if [[ ! -x "$VOZUAL_PYTHON" ]]; then
    osascript -e 'display alert "VOZUAL no puede iniciar" message "No se encontró el entorno local de Python. Abre el proyecto Vozual para repararlo." as critical'
    exit 1
fi

if [[ ! -f "$VOZUAL_REPO/ml/src/sign_authoring_editor.py" ]]; then
    osascript -e 'display alert "VOZUAL no puede iniciar" message "No se encontró el proyecto Vozual en su ubicación original." as critical'
    exit 1
fi

cd "$VOZUAL_REPO"
exec /usr/bin/arch -arm64 \
    "$VOZUAL_PYTHON" \
    "$VOZUAL_REPO/ml/src/sign_authoring_editor.py" \
    >> "$VOZUAL_LOG_DIR/editor.log" 2>&1
