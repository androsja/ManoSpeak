# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# This project uses React Native's static-library integration. Firebase's SPM
# products require dynamic linkage, so resolve Firebase through CocoaPods.
$RNFirebaseDisableSPM = true

# Firebase's iOS SDK includes Swift modules. Static frameworks expose their
# generated compatibility headers without adding dynamic runtime frameworks.
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

# VOZUAL uses the microphone recognizer, not VisionCamera frame processors.
# Disabling this optional extension avoids the legacy RCTCxxBridge installer
# that is not compatible with React Native 0.87's new architecture.
$VCEnableFrameProcessors = false

target 'Vozual' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'VozualTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    # Ensure all pods meet the minimum iOS deployment target required by TFLite
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1' if current.to_f < 15.1

        # Worklets 1.6 imports JavaScriptCore through ReactCommon's source
        # layout. Static frameworks do not expose the legacy `jsc/` prefix,
        # so keep that source include available to this pod only.
        if target.name == 'react-native-worklets-core'
          search_paths = Array(config.build_settings['HEADER_SEARCH_PATHS'])
          react_common = '"${PODS_ROOT}/../../node_modules/react-native/ReactCommon"'
          config.build_settings['HEADER_SEARCH_PATHS'] = search_paths | ['$(inherited)', react_common]
        end

        # These two native modules still use the legacy bridge API internally.
        # Compile their bridge shim with the legacy flag while the application
        # itself remains on React Native's new architecture.
        if ['react-native-worklets-core', 'onnxruntime-react-native'].include?(target.name)
          flags = Array(config.build_settings['OTHER_CPLUSPLUSFLAGS'])
          flags = flags.flat_map { |flag| flag.to_s.gsub('-DRCT_NEW_ARCH_ENABLED=1', '-DRCT_NEW_ARCH_ENABLED=0') }
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = flags | ['$(inherited)', '-DRCT_NEW_ARCH_ENABLED=0']
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] =
            Array(config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']) | ['$(inherited)', 'RCT_NEW_ARCH_ENABLED=0']
        end
      end
    end
  end
end
