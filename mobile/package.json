{
  "name": "vozual-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "audit:avatar-signs": "esbuild tools/audit-avatar-signs.ts --bundle --platform=node --format=cjs --outfile=build/audit-avatar-signs.cjs && node build/audit-avatar-signs.cjs",
    "audit:avatar-visual": "node tools/capture-avatar-visual-audit.cjs",
    "audit:dependencies": "node tools/check-npm-audit.js",
    "build:avatar-runtime": "bash tools/build-avatar-runtime.sh",
    "build:published-signs": "node tools/build-published-signs.js",
    "status:published-signs": "node tools/firebase-sign-status.js",
    "publish:approved-signs": "node tools/publish-approved-signs.js",
    "verify:published-signs": "node tools/verify-published-signs.js",
    "verify:release-assets": "node tools/check-release-assets.js",
    "verify:release:android": "bash tools/verify-android-release.sh",
    "test:release-verifier": "bash tools/test-android-release-verifier.sh",
    "release:check:android": "bash tools/android-release-check.sh",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx index.js src --ext .js,.jsx,.ts,.tsx",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/auth": "26.4.0",
    "@react-native-firebase/firestore": "26.4.0",
    "@react-native-firebase/remote-config": "26.4.0",
    "@react-native-google-signin/google-signin": "16.1.5",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-fs": "^2.20.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "15.15.5",
    "react-native-tts": "^4.1.1",
    "react-native-vision-camera": "4.7.3",
    "react-native-webview": "14.0.1",
    "react-native-worklets-core": "1.6.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "eslint": "^8.19.0",
    "jest": "^29.5.0",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "body-parser": "2.4.0",
    "compression": "1.8.2",
    "joi": "17.13.9",
    "launch-editor": "2.14.2",
    "re2js": "2.8.7",
    "shell-quote": "1.12.0"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.3.0 <25 || >=26"
  }
}
