{
  "name": "manospeak-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "audit:avatar-signs": "esbuild tools/audit-avatar-signs.ts --bundle --platform=node --format=cjs --outfile=build/audit-avatar-signs.cjs && node build/audit-avatar-signs.cjs",
    "audit:avatar-visual": "node tools/capture-avatar-visual-audit.cjs",
    "build:avatar-runtime": "bash tools/build-avatar-runtime.sh",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No lint errors'",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/auth": "25.1.0",
    "@react-native-firebase/firestore": "^25.1.0",
    "@react-native-firebase/remote-config": "25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-voice/voice": "^3.2.4",
    "onnxruntime-react-native": "^1.24.3",
    "react": "18.3.1",
    "react-native": "0.76.3",
    "react-native-fs": "^2.20.0",
    "react-native-svg": "^15.8.0",
    "react-native-tts": "^4.1.1",
    "react-native-vision-camera": "4.7.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets-core": "1.6.3",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^15.0.1",
    "@react-native-community/cli-platform-android": "^15.0.1",
    "@react-native-community/cli-platform-ios": "^15.0.1",
    "@react-native/babel-preset": "^0.76.3",
    "@react-native/eslint-config": "^0.76.3",
    "@react-native/metro-config": "^0.76.3",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.9",
    "jest": "^29.5.0",
    "metro": "^0.81.5",
    "metro-config": "^0.81.5",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.4"
  }
}
