#!/usr/bin/env bash
set -euo pipefail

case "${2:-}" in
  config)
    printf 'compression { uncompressedGlob: "lib/**" }\nPAGE_ALIGNMENT_16K\n'
    ;;
  manifest)
    printf '<manifest package="%s" android:compileSdkVersion="%s"><uses-sdk android:targetSdkVersion="%s" /></manifest>\n' \
      "${MOCK_PACKAGE:-com.androsja.vozual}" \
      "${MOCK_COMPILE_SDK:-36}" \
      "${MOCK_TARGET_SDK:-36}"
    ;;
  *)
    printf 'Unexpected bundletool fixture arguments.\n' >&2
    exit 2
    ;;
esac
