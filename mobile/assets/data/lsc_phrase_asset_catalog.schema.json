{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vozual.app/schemas/lsc-phrase-asset-catalog-v1.json",
  "title": "Vozual reviewed LSC phrase asset catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "language",
    "unsupportedOutcome",
    "entries"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "catalogVersion": {"type": "string", "minLength": 1},
    "language": {"const": "lsc-CO"},
    "unsupportedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "message", "retryLabel"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryLabel": {"type": "string", "minLength": 1}
      }
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "spanish",
        "lsc",
        "clips",
        "licence",
        "performerConsent",
        "review"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "status": {
          "enum": ["candidate", "in_review", "active", "rejected", "withdrawn"]
        },
        "spanish": {
          "type": "object",
          "additionalProperties": false,
          "required": ["variants", "intendedMeaning"],
          "properties": {
            "variants": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "intendedMeaning": {"type": "string", "minLength": 1}
          }
        },
        "lsc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["glossSequence", "regionalVariant"],
          "properties": {
            "glossSequence": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "regionalVariant": {"type": "string"}
          }
        },
        "clips": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "recordId"],
          "properties": {
            "status": {"enum": ["pending", "verified", "rejected", "withdrawn"]},
            "recordId": {"type": ["string", "null"]}
          }
        },
        "performerConsent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "recordId", "version"],
          "properties": {
            "status": {"enum": ["pending", "granted", "denied", "withdrawn"]},
            "recordId": {"type": ["string", "null"]},
            "version": {"type": ["string", "null"]}
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewerId", "version", "reviewedAt"],
          "properties": {
            "status": {"enum": ["pending", "approved", "rejected", "expired"]},
            "reviewerId": {"type": ["string", "null"]},
            "version": {"type": ["string", "null"]},
            "reviewedAt": {"type": ["string", "null"], "format": "date-time"}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "active"}}},
          "then": {
            "properties": {
              "lsc": {
                "properties": {
                  "glossSequence": {"minItems": 1},
                  "regionalVariant": {"minLength": 1}
                }
              },
              "clips": {"minItems": 1},
              "licence": {
                "properties": {
                  "status": {"const": "verified"},
                  "recordId": {"type": "string", "minLength": 1}
                }
              },
              "performerConsent": {
                "properties": {
                  "status": {"const": "granted"},
                  "recordId": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1}
                }
              },
              "review": {
                "properties": {
                  "status": {"const": "approved"},
                  "reviewerId": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1},
                  "reviewedAt": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
