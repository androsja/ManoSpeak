rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'providers',
          'country',
          'selectedSignLanguage',
          'createdAt',
          'lastSeenAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time;
      allow update: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'providers',
          'country',
          'selectedSignLanguage',
          'createdAt',
          'lastSeenAt'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if owns(uid);
    }

    match /access/{uid} {
      allow read: if owns(uid);
      allow create, update: if false;
      allow delete: if owns(uid);
    }

    match /usage/{uid} {
      allow read, delete: if owns(uid);
      allow create, update: if false;
    }

    match /usage/{uid}/periods/{periodId} {
      allow read: if owns(uid);
      allow create, update: if false;
      allow delete: if owns(uid);
    }

    // Public metadata only for the original catalogue. Legacy JSON motion
    // payloads use the isolated, versioned collections below; trusted
    // publisher tooling bypasses these client rules.
    match /signLanguages/{languageId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    match /signs/{signId} {
      // Only trusted tooling can create documents. Keeping the metadata query
      // predicate limited to `published` lets Firestore prove that a public
      // catalogue query cannot include drafts. The client still validates all
      // schema and approval fields before presenting a sign.
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    match /signs/{signId}/versions/{versionId} {
      allow read: if get(/databases/$(database)/documents/signs/$(signId)).data.published == true
        && get(/databases/$(database)/documents/signs/$(signId)).data.approved == true
        && get(/databases/$(database)/documents/signs/$(signId)).data.compiled == true
        && resource.data.published == true
        && resource.data.approved == true
        && resource.data.compiled == true
        && resource.data.sha256 is string
        && resource.data.sizeBytes is int
        && resource.data.sizeBytes > 0
        && resource.data.storagePath is string
        && !resource.data.keys().hasAny(['contentBase64']);
      allow write: if false;
    }

    // Reviewed phrase suggestions are compact metadata. The app downloads them
    // into the same transactional local-library state as their referenced
    // signs, then exposes a phrase only when every required sign is present.
    match /phrases/{phraseId} {
      // Keep this predicate queryable. The client independently rejects any
      // document that is not approved or does not satisfy the exact schema.
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // JSON motion releases are a separate, versioned catalogue for the
    // lightweight Android starter experience. The legacy global signs query
    // is never used to populate this release.
    match /signJsonReleasePointers/{languageId} {
      allow read: if resource.data.schema == 'vozual.sign-json-release-pointer'
        && resource.data.published == true;
      allow write: if false;
    }

    match /signJsonReleases/{releaseId} {
      allow read: if resource.data.schema == 'vozual.sign-json-release'
        && resource.data.published == true;
      allow write: if false;

      match /motions/{signId}/chunks/{chunkId} {
        allow read: if get(/databases/$(database)/documents/signJsonReleases/$(releaseId)).data.published == true;
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
